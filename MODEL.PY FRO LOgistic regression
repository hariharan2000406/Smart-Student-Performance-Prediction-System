import pandas as pd
import joblib

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import accuracy_score


# ============================================================
# 1. LOAD DATASET
# ============================================================

data = pd.read_csv(
    "student_performance_200_no_recommendation.csv"
)


# ============================================================
# 2. INPUT FEATURES
# ============================================================

X = data[
    [
        "Attendance",
        "Study_Hours",
        "Internal_Marks",
        "Assignment",
        "Previous_Score"
    ]
]


# ============================================================
# 3. CREATE RESULT CATEGORY
# ============================================================

data["Result"] = data["Final_Score"].apply(
    lambda x:
        "Excellent" if x >= 75
        else "Good" if x >= 60
        else "Average" if x >= 45
        else "Poor"
)


# ============================================================
# 4. TARGET
# ============================================================

y = data["Result"]


# ============================================================
# 5. SPLIT DATA
# ============================================================

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)


# ============================================================
# 6. LOGISTIC REGRESSION
# ============================================================

logistic_model = LogisticRegression(
    max_iter=1000
)

logistic_model.fit(
    X_train,
    y_train
)

logistic_result = logistic_model.predict(
    X_test
)

logistic_accuracy = accuracy_score(
    y_test,
    logistic_result
)

logistic_percentage = logistic_accuracy * 100


# ============================================================
# 7. DECISION TREE
# ============================================================

tree_model = DecisionTreeClassifier(
    random_state=42
)

tree_model.fit(
    X_train,
    y_train
)

tree_result = tree_model.predict(
    X_test
)

tree_accuracy = accuracy_score(
    y_test,
    tree_result
)

tree_percentage = tree_accuracy * 100


# ============================================================
# 8. DISPLAY RESULTS
# ============================================================

print("==============================================")
print("       MODEL ACCURACY COMPARISON")
print("==============================================")

print(
    "Logistic Regression :",
    round(logistic_percentage, 2),
    "%"
)

print(
    "Decision Tree       :",
    round(tree_percentage, 2),
    "%"
)

print("==============================================")


# ============================================================
# 9. SAVE BOTH MODELS
# ============================================================

joblib.dump(
    logistic_model,
    "student_logistic_model.pkl"
)

joblib.dump(
    tree_model,
    "student_decision_tree_model.pkl"
)


print("Logistic Regression model saved successfully")
print("Decision Tree model saved successfully")
